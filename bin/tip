#!/usr/bin/env bash
# bin/tip - Terminal Image Paste CLI Entrypoint
# Version 1.0.0

set -e

TIP_VERSION="1.0.0"
SOURCE_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# Resolve library directory across development, user, and system installations
if [[ -d "${SOURCE_DIR}/lib" && -f "${SOURCE_DIR}/lib/logger.sh" ]]; then
    LIB_DIR="${SOURCE_DIR}/lib"
elif [[ -d "${SOURCE_DIR}/lib/tip" && -f "${SOURCE_DIR}/lib/tip/logger.sh" ]]; then
    LIB_DIR="${SOURCE_DIR}/lib/tip"
elif [[ -d "${HOME}/.local/lib/tip" && -f "${HOME}/.local/lib/tip/logger.sh" ]]; then
    LIB_DIR="${HOME}/.local/lib/tip"
elif [[ -d "/usr/local/lib/tip" && -f "/usr/local/lib/tip/logger.sh" ]]; then
    LIB_DIR="/usr/local/lib/tip"
elif [[ -d "/usr/lib/tip" && -f "/usr/lib/tip/logger.sh" ]]; then
    LIB_DIR="/usr/lib/tip"
elif [[ -d "/usr/share/tip/lib" && -f "/usr/share/tip/lib/logger.sh" ]]; then
    LIB_DIR="/usr/share/tip/lib"
else
    echo "Error: Cannot locate tip library directory." >&2
    exit 1
fi

# Load modules
# shellcheck source=lib/logger.sh
source "${LIB_DIR}/logger.sh"
# shellcheck source=lib/config.sh
source "${LIB_DIR}/config.sh"
# shellcheck source=lib/clipboard.sh
source "${LIB_DIR}/clipboard.sh"
# shellcheck source=lib/formatter.sh
source "${LIB_DIR}/formatter.sh"
# shellcheck source=lib/injector.sh
source "${LIB_DIR}/injector.sh"
# shellcheck source=lib/doctor.sh
source "${LIB_DIR}/doctor.sh"
# shellcheck source=lib/tui.sh
source "${LIB_DIR}/tui.sh"
# shellcheck source=lib/shortcut.sh
source "${LIB_DIR}/shortcut.sh"

tip_help() {
    local C_RESET="\033[0m"
    local C_BOLD="\033[1m"
    local C_CYAN="\033[36m"
    local C_GREEN="\033[32m"
    local C_YELLOW="\033[33m"
    local C_DIM="\033[2m"

    echo -e "${C_CYAN}${C_BOLD}Terminal Image Paste (tip) - v${TIP_VERSION}${C_RESET}"
    echo -e "${C_DIM}Quickly paste images from clipboard into terminal on Linux (Wayland / X11)${C_RESET}"
    echo ""
    echo -e "${C_YELLOW}${C_BOLD}USAGE:${C_RESET}"
    echo -e "  tip [command] [options]"
    echo -e "  tip config                ${C_DIM}(Open interactive TUI configuration menu)${C_RESET}"
    echo ""
    echo -e "${C_GREEN}${C_BOLD}QUICK START:${C_RESET}"
    echo -e "  1. ${C_CYAN}tip doctor${C_RESET}       Check system dependencies and environment"
    echo -e "  2. ${C_CYAN}tip config${C_RESET}       Open TUI menu to select paste format (timg, path, custom...)"
    echo -e "  3. ${C_CYAN}tip paste${C_RESET}        Paste image directly from clipboard into active terminal"
    echo ""
    echo -e "${C_YELLOW}${C_BOLD}COMMANDS:${C_RESET}"
    echo -e "  ${C_BOLD}Core Actions:${C_RESET}"
    echo -e "    ${C_CYAN}paste${C_RESET}             Extract clipboard image, format, and type into terminal"
    echo -e "    ${C_CYAN}status${C_RESET}            Show current configuration and environment summary"
    echo ""
    echo -e "  ${C_BOLD}Configuration & TUI:${C_RESET}"
    echo -e "    ${C_CYAN}config${C_RESET}            Open interactive TUI menu for configuration"
    echo -e "    ${C_CYAN}config show${C_RESET}       Print current configuration file (~/.config/tip/config.conf)"
    echo -e "    ${C_CYAN}config edit${C_RESET}       Open configuration file in editor"
    echo -e "    ${C_CYAN}config path${C_RESET}       Print configuration file path"
    echo -e "    ${C_CYAN}config set <k> <v>${C_RESET} Set configuration property from CLI"
    echo -e "    ${C_CYAN}shortcut [key]${C_RESET}    Automatically register desktop shortcut (Niri)"
    echo ""
    echo -e "  ${C_BOLD}Diagnostics & Logs:${C_RESET}"
    echo -e "    ${C_CYAN}doctor${C_RESET}            Run system and dependency diagnostics"
    echo -e "    ${C_CYAN}log [-f] [-n N]${C_RESET}   View activity logs (-f to follow realtime, default 30 lines)"
    echo ""
    echo -e "  ${C_BOLD}Help & Version:${C_RESET}"
    echo -e "    ${C_CYAN}help, -h, --help${C_RESET}  Display this help screen"
    echo -e "    ${C_CYAN}version, -v${C_RESET}       Display current version"
    echo ""
    echo -e "${C_DIM}Default global shortcut: ${C_YELLOW}<Ctrl><Super>v${C_RESET}"
    echo ""
}

cmd_paste() {
    tip_log_info "Executing tip paste command..."
    local img_path
    if ! img_path=$(tip_clipboard_extract); then
        exit 1
    fi

    local formatted_text
    formatted_text=$(tip_format_output "$img_path")

    local auto_enter="false"
    if tip_should_auto_enter; then
        auto_enter="true"
    fi

    tip_inject_text "$formatted_text" "$auto_enter"
}

cmd_status() {
    local display_server
    display_server=$(tip_detect_display_server)
    echo "Terminal Image Paste (tip) - v${TIP_VERSION}"
    echo "----------------------------------------"
    printf "%-18s: %s\n" "Display Server" "$display_server"
    printf "%-18s: %s\n" "Paste Format"   "${PASTE_FORMAT:-timg}"
    printf "%-18s: %s\n" "Auto Enter"     "${AUTO_ENTER:-false}"
    printf "%-18s: %s\n" "Storage Dir"    "${STORAGE_DIR:-/tmp}"
    printf "%-18s: %s\n" "Log File"       "$TIP_LOG_FILE"
    printf "%-18s: %s\n" "Config File"    "$TIP_CONFIG_FILE"
}

cmd_config() {
    local subcmd="${1:-tui}"
    case "$subcmd" in
        tui)
            tip_tui_main_menu
            ;;
        set)
            if [[ -z "$2" ]]; then
                echo "Usage: tip config set <KEY> <VALUE>" >&2
                return 1
            fi
            tip_config_set "$2" "$3"
            echo "Updated: $2=\"$3\""
            ;;
        path)
            echo "$TIP_CONFIG_FILE"
            ;;
        edit)
            local editor="${EDITOR:-nano}"
            "$editor" "$TIP_CONFIG_FILE"
            ;;
        show)
            tip_config_show
            ;;
        *)
            echo "Invalid config option: $subcmd" >&2
            echo "Run 'tip config' to open TUI or 'tip help' for usage." >&2
            exit 1
            ;;
    esac
}

main() {
    tip_config_load

    local cmd="${1:-help}"
    shift || true

    case "$cmd" in
        paste)
            cmd_paste "$@"
            ;;
        log)
            tip_show_logs "$@"
            ;;
        doctor)
            tip_run_doctor "$@"
            ;;
        config)
            cmd_config "$@"
            ;;
        shortcut)
            tip_shortcut_install "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        version|-v|--version)
            echo "tip version ${TIP_VERSION}"
            ;;
        help|-h|--help)
            tip_help
            ;;
        *)
            echo "Invalid command: $cmd" >&2
            echo "Run 'tip help' to view available commands." >&2
            exit 1
            ;;
    esac
}

main "$@"
